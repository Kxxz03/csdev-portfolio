---
/**
 * Fondo animado WebGL1, sin librerías.
 *
 * Es el shader "Plasma" del constructor de 21st.dev, pero con los ajustes
 * cambiados para que funcione como LUZ y no como papel pintado. Con los
 * valores originales, un plasma a pantalla completa le come el
 * protagonismo al producto: acá tiene que hacer lo contrario, dar
 * temperatura al fondo para que una zapatilla blanca no se lea lavada.
 *
 * Qué cambió respecto de los valores que vinieron:
 *
 *   velocidad   0.86 -> 0.14   una página de producto no parpadea
 *   intensidad  0.48 -> 0.20   menos ondas, manchas más grandes
 *   escala      1.50 -> 0.55   formas amplias en vez de patrón repetido
 *   grano       0.35 -> 0.06   el grano fuerte lee como ruido de vídeo
 *   viñeta      0.61 -> 0.86   empuja el color a los bordes y despeja
 *                              el centro, que es donde va el producto
 *   saturación  1.00 -> 0.62   el naranja tiene que medir, no gritar
 *
 * Encima va una máscara radial en CSS: el color queda en la periferia y
 * el centro se mantiene casi grafito.
 */
interface Props {
  /** Opacidad del lienzo. Por debajo de 0.5 deja de competir. */
  fuerza?: number
}
const { fuerza = 0.42 } = Astro.props
---

<canvas id="plasma" aria-hidden="true" style={`--fuerza:${fuerza}`}></canvas>

<style>
  #plasma {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: var(--fuerza);
    /* El centro se despeja para que el producto no compita con el fondo */
    -webkit-mask-image: radial-gradient(
      ellipse 62% 58% at 50% 52%,
      transparent 0%,
      rgba(0, 0, 0, 0.55) 48%,
      #000 78%
    );
    mask-image: radial-gradient(
      ellipse 62% 58% at 50% 52%,
      transparent 0%,
      rgba(0, 0, 0, 0.55) 48%,
      #000 78%
    );
  }

  /* Sin movimiento: el fondo queda, pero congelado en su primer cuadro.
     Se pierde la animación, no la temperatura. */
  @media (prefers-reduced-motion: reduce) {
    #plasma {
      opacity: calc(var(--fuerza) * 0.8);
    }
  }
</style>

<script>
  const lienzo = document.getElementById('plasma') as HTMLCanvasElement | null
  if (lienzo) arrancar(lienzo)

  function arrancar(lienzo: HTMLCanvasElement): void {
    const gl = lienzo.getContext('webgl', {
      antialias: false,
      alpha: true,
      powerPreference: 'low-power',
    })
    // Sin WebGL la página sigue funcionando: queda el grafito plano.
    if (!gl) return

    const vertice = `
      attribute vec2 a;
      void main() { gl_Position = vec4(a, 0.0, 1.0); }
    `

    const fragmento = `
      #ifdef GL_FRAGMENT_PRECISION_HIGH
      precision highp float;
      #else
      precision mediump float;
      #endif

      uniform vec3 u_colors[4];
      uniform vec4 u_scene;    // resolucion.xy, tiempo, cantidad de colores
      uniform vec4 u_shape;    // escala, intensidad, -, -
      uniform vec4 u_surface;  // -, contraste, brillo, saturacion
      uniform vec4 u_finish;   // tono, viñeta, -, grano

      #define u_resolution u_scene.xy
      #define u_time u_scene.z
      #define u_colorCount u_scene.w
      #define u_scale u_shape.x
      #define u_intensity u_shape.y
      #define u_contrast u_surface.y
      #define u_brightness u_surface.z
      #define u_saturation u_surface.w
      #define u_hue u_finish.x
      #define u_vignette u_finish.y
      #define u_grain u_finish.w

      /* Ruido parejo para el grano. Un hash multiplicativo deja una
         retícula tenue alineada a los ejes que se nota en zonas planas. */
      float grainHash(vec2 p) {
        vec3 p3 = fract(vec3(p.xyx) * 0.1031);
        p3 += dot(p3, p3.yzx + 33.33);
        return fract((p3.x + p3.y) * p3.z);
      }

      /* WebGL1 prohíbe indexar uniformes con variables en el fragmento,
         de ahí el bucle con límite constante. */
      vec3 paleta(float x) {
        float n = max(u_colorCount - 1.0, 1.0);
        float f = clamp(x, 0.0, 1.0) * n;
        vec3 col = u_colors[0];
        for (int i = 0; i < 3; i++) {
          if (float(i) < n) {
            col = mix(col, u_colors[i + 1],
              smoothstep(0.0, 1.0, clamp(f - float(i), 0.0, 1.0)));
          }
        }
        return col;
      }

      vec3 rotarTono(vec3 col, float a) {
        const mat3 aYIQ = mat3(0.299, 0.596, 0.211,
                               0.587, -0.274, -0.523,
                               0.114, -0.322, 0.312);
        const mat3 aRGB = mat3(1.0, 1.0, 1.0,
                               0.956, -0.272, -1.106,
                               0.621, -0.647, 1.703);
        vec3 yiq = aYIQ * col;
        float c = cos(a), s = sin(a);
        yiq = vec3(yiq.x, yiq.y * c - yiq.z * s, yiq.y * s + yiq.z * c);
        return aRGB * yiq;
      }

      void main() {
        vec2 uvPantalla = gl_FragCoord.xy / u_resolution.xy;
        vec2 p = (gl_FragCoord.xy - 0.5 * u_resolution.xy)
          / min(u_resolution.x, u_resolution.y);
        p *= u_scale;

        float k = 2.0 + u_intensity * 6.0;
        float t = u_time;
        float v = sin(p.x * k + t)
          + sin(p.y * k * 0.8 - t * 0.7)
          + sin((p.x + p.y) * k * 0.6 + t * 0.5)
          + sin(length(p) * k * 1.2 - t);

        vec3 col = paleta(0.5 + 0.5 * sin(v));

        col = (col - 0.5) * u_contrast + 0.5;

        float luma = dot(col, vec3(0.299, 0.587, 0.114));
        col = mix(vec3(luma), col, u_saturation);

        if (abs(u_hue) > 0.0001) col = rotarTono(col, u_hue);
        col += u_brightness;

        float d = length(uvPantalla - 0.5) * 1.41421356;
        col *= 1.0 - u_vignette * smoothstep(0.35, 1.0, d);

        col += (grainHash(gl_FragCoord.xy) - 0.5) * u_grain;

        gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
      }
    `

    function compilar(tipo: number, fuente: string): WebGLShader | null {
      const s = gl!.createShader(tipo)!
      gl!.shaderSource(s, fuente)
      gl!.compileShader(s)
      if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) {
        console.warn('[plasma]', gl!.getShaderInfoLog(s))
        return null
      }
      return s
    }

    const vs = compilar(gl.VERTEX_SHADER, vertice)
    const fs = compilar(gl.FRAGMENT_SHADER, fragmento)
    if (!vs || !fs) return

    const programa = gl.createProgram()!
    gl.attachShader(programa, vs)
    gl.attachShader(programa, fs)
    gl.linkProgram(programa)
    gl.useProgram(programa)

    /* Un triángulo que cubre la pantalla. Sale más barato que dos que
       formen un rectángulo: sin diagonal, no hay píxeles procesados dos
       veces en la costura. */
    const buffer = gl.createBuffer()
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer)
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW
    )
    const a = gl.getAttribLocation(programa, 'a')
    gl.enableVertexAttribArray(a)
    gl.vertexAttribPointer(a, 2, gl.FLOAT, false, 0, 0)

    const u = (n: string) => gl.getUniformLocation(programa, n)
    const uColors = u('u_colors')
    const uScene = u('u_scene')
    const uShape = u('u_shape')
    const uSurface = u('u_surface')
    const uFinish = u('u_finish')

    // Del casi negro cálido al crema. Los mismos cuatro que pediste.
    gl.uniform3fv(uColors, new Float32Array([
      0.086, 0.043, 0.043,
      0.761, 0.251, 0.165,
      0.957, 0.616, 0.216,
      1.000, 0.910, 0.761,
    ]))

    // Ver la cabecera del componente para el porqué de cada valor.
    gl.uniform4f(uShape, 0.55, 0.20, 0.0, 0.0)
    gl.uniform4f(uSurface, 0.0, 0.88, -0.06, 0.62)
    gl.uniform4f(uFinish, 3.04, 0.86, 0.0, 0.06)

    const VELOCIDAD = 0.14

    function medir(): void {
      // Tope de 2 en la densidad: por encima el costo sube al cuadrado y
      // en un fondo desenfocado no se nota.
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      const w = Math.floor(window.innerWidth * dpr)
      const h = Math.floor(window.innerHeight * dpr)
      if (lienzo.width === w && lienzo.height === h) return
      lienzo.width = w
      lienzo.height = h
      gl!.viewport(0, 0, w, h)
    }

    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let pedido = 0

    function pintar(ms: number): void {
      medir()
      gl!.uniform4f(uScene, lienzo.width, lienzo.height, ms * 0.001 * VELOCIDAD, 4.0)
      gl!.drawArrays(gl!.TRIANGLES, 0, 3)
      pedido = requestAnimationFrame(pintar)
    }

    if (quieto) {
      // Un solo cuadro: queda la temperatura, se va el movimiento.
      medir()
      gl.uniform4f(uScene, lienzo.width, lienzo.height, 0.0, 4.0)
      gl.drawArrays(gl.TRIANGLES, 0, 3)
    } else {
      pedido = requestAnimationFrame(pintar)
    }

    /* Con la pestaña oculta el bucle sigue costando batería sin que nadie
       lo vea. */
    document.addEventListener('visibilitychange', () => {
      if (quieto) return
      if (document.hidden) {
        cancelAnimationFrame(pedido)
      } else {
        pedido = requestAnimationFrame(pintar)
      }
    })

    window.addEventListener('resize', medir, { passive: true })
  }
</script>
