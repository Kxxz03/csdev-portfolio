  <script define:vars={{ CUADROS }}>
    // Astro pasa CUADROS desde el frontmatter, para no repetir el número.
    window.__NANDU_CUADROS = CUADROS;
  </script>

  <script>
    import Lenis from 'lenis'
    import gsap from 'gsap'
    import ScrollTrigger from 'gsap/ScrollTrigger'

    gsap.registerPlugin(ScrollTrigger)

    const TOTAL: number = (window as any).__NANDU_CUADROS

    /* ?movimiento fuerza el giro aunque el sistema pida menos movimiento.
       Sirve para revisar la pieza desde un equipo con esa preferencia
       activada, que si no solo ve la variante estática. */
    const forzado = new URLSearchParams(location.search).has('movimiento')
    const suave =
      forzado || !window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (forzado) document.documentElement.dataset.movimiento = 'forzado'

    const lienzo = document.getElementById('giro') as HTMLCanvasElement
    const ctx = lienzo.getContext('2d')!
    const aviso = document.getElementById('cargando')!
    const barra = document.getElementById('barra')!

    /* ── Elección del juego de imágenes ────────────────────────────────
       Se decide una sola vez, al cargar. Cambiar de juego a mitad de un
       giro obligaría a precargar de nuevo y se vería el corte. */
    const anchoReal = window.innerWidth * Math.min(window.devicePixelRatio || 1, 2)
    const JUEGO = anchoReal > 1100 ? '1096' : '548'

    const cuadros: HTMLImageElement[] = []
    let listos = 0
    let actual = -1

    function ruta(i: number): string {
      return `/nandu/giro/${JUEGO}/${String(i + 1).padStart(2, '0')}.webp`
    }

    /* Dibuja el cuadro pedido. Sale temprano si ya es el que está en
       pantalla: durante un scrub la misma imagen se pide muchas veces
       seguidas y redibujar cuesta sin cambiar nada. */
    function dibujar(indice: number): void {
      const i = Math.max(0, Math.min(TOTAL - 1, indice))
      if (i === actual) return
      const img = cuadros[i]
      if (!img || !img.complete) return

      actual = i
      ctx.clearRect(0, 0, lienzo.width, lienzo.height)
      ctx.drawImage(img, 0, 0, lienzo.width, lienzo.height)
    }

    /* ── Precarga completa ─────────────────────────────────────────────
       El giro no arranca hasta tener los 36. Con carga perezosa, el
       primer barrido muestra huecos justo en el momento que tiene que
       impresionar. Un MB entero es barato a cambio de eso. */
    function precargar(): Promise<void> {
      return new Promise((resolve) => {
        for (let i = 0; i < TOTAL; i++) {
          const img = new Image()
          img.decoding = 'async'
          img.src = ruta(i)
          img.onload = img.onerror = () => {
            listos++
            aviso.textContent = `CARGANDO ${String(listos).padStart(2, '0')} / ${TOTAL}`
            if (i === 0) dibujar(0)
            if (listos === TOTAL) resolve()
          }
          cuadros[i] = img
        }
      })
    }







    /* El corte de un bloque viejo se llevó esta llamada y el giro quedó
       en "CARGANDO 00 / 36" para siempre. */
    precargar().then(() => {
      aviso.hidden = true
      if (suave) anclarGiro()
    })

    function anclarGiro(): void {
      const lenis = new Lenis({
        duration: 1.1,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      })
      gsap.ticker.add((t) => lenis.raf(t * 1000))
      gsap.ticker.lagSmoothing(0)

      /* Lenis toma el control del desplazamiento y ScrollTrigger no se
         entera solo: sin esta línea la escena queda anclada pero el
         progreso nunca avanza, y la zapatilla no gira. */
      lenis.on('scroll', ScrollTrigger.update)
      ;(window as any).__lenis = lenis

      const avance = { valor: 0 }
      gsap.to(avance, {
        valor: TOTAL - 1,
        ease: 'none',
        scrollTrigger: {
          trigger: '#escena',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.3,
          onUpdate: (self) => {
            barra.style.transform = `scaleX(${self.progress})`
          },
        },
        onUpdate: () => dibujar(Math.round(avance.valor)),
      })

      /* Las cotas se escriben una por una al entrar. Es el único momento
         que no depende del scroll. */
      gsap.to('.cota', {
        opacity: 1,
        duration: 0.5,
        stagger: 0.09,
        delay: 0.2,
        ease: 'power2.out',
      })
    }

    /* ── Visor del despiece ───────────────────────────────────────────
       Dos ejes a la vez: girar y desarmar. Un giro solo, o un desarme
       solo, se resuelven con una secuencia; poder hacer las dos cosas
       necesita una malla de 18 ángulos por 5 estados de apertura.

       Los 90 cuadros NO se cargan de una: primero los 18 del estado
       armado, que es con lo que ya se puede girar, y el resto detrás.
       Esperar 3 MB antes de poder tocar nada arruina justo el momento
       que tiene que enganchar.

       El arrastre sigue los principios de manipulación directa: 1 a 1
       mientras se arrastra, sigue girando al soltar con la velocidad que
       traía, y se puede agarrar en pleno giro para cambiarle el sentido. */
    // 18 ángulos, uno cada 20 grados. Con 24 la matriz pesaba 5 MB
    // entre los dos juegos; el salto entre cuadros casi no se nota.
    const ANGULOS = 18
    const ESTADOS = 5
    const JUEGO_OBRA = anchoReal > 900 ? '480' : '320'

    const lienzoObra = document.getElementById('despiece') as HTMLCanvasElement
    const ctxObra = lienzoObra.getContext('2d')!
    const avisoObra = document.getElementById('obraCargando')!
    const zonaGiro = document.getElementById('obraPieza')!
    const pista = document.getElementById('pista')
    const mando = document.getElementById('apertura') as HTMLInputElement | null

    const malla: HTMLImageElement[][] = Array.from({ length: ESTADOS }, () => [])
    let angulo = 0
    let estado = 0
    let ultimoDibujo = ''

    function rutaMalla(e: number, a: number): string {
      const n = String(a + 1).padStart(2, '0')
      return '/nandu/matriz/' + JUEGO_OBRA + '/e' + e + '/' + n + '.webp'
    }

    function cargarEstado(e: number): Promise<void> {
      return new Promise((listo) => {
        let n = 0
        for (let a = 0; a < ANGULOS; a++) {
          const imgMalla = new Image()
          imgMalla.decoding = 'async'
          imgMalla.src = rutaMalla(e, a)
          imgMalla.onload = imgMalla.onerror = () => {
            if (++n === ANGULOS) listo()
          }
          malla[e][a] = imgMalla
        }
      })
    }

    function indiceAngulo(grados: number): number {
      const paso = 360 / ANGULOS
      return ((Math.round(grados / paso) % ANGULOS) + ANGULOS) % ANGULOS
    }

    function dibujarMalla(): void {
      const a = indiceAngulo(angulo)
      const clave = estado + ':' + a
      // Durante un arrastre el mismo cuadro se pide muchas veces seguidas
      if (clave === ultimoDibujo) return

      const imgMalla = malla[estado][a]
      if (!imgMalla || !imgMalla.complete || !imgMalla.naturalWidth) return

      ultimoDibujo = clave
      ctxObra.clearRect(0, 0, lienzoObra.width, lienzoObra.height)
      ctxObra.drawImage(imgMalla, 0, 0, lienzoObra.width, lienzoObra.height)
    }

    // Primero lo armado: con eso ya se puede girar. El resto entra detrás.
    cargarEstado(0).then(() => {
      avisoObra.hidden = true
      dibujarMalla()
      for (let e = 1; e < ESTADOS; e++) cargarEstado(e)
    })

    mando?.addEventListener('input', () => {
      estado = Math.min(ESTADOS - 1, Math.max(0, Number(mando.value)))
      dibujarMalla()
    })

    /* ── Girar arrastrando ────────────────────────────────────────── */
    const GRADOS_POR_PIXEL = 0.6
    const ROCE = 0.94
    const CORTE = 0.02

    let velocidad = 0
    let arrastrando = false
    let ultimoX = 0
    let historia: { x: number; t: number }[] = []
    let inercia = 0

    function girarSolo(): void {
      if (arrastrando) return
      velocidad *= ROCE
      if (Math.abs(velocidad) < CORTE) {
        velocidad = 0
        return
      }
      angulo += velocidad
      dibujarMalla()
      inercia = requestAnimationFrame(girarSolo)
    }

    zonaGiro.addEventListener('pointerdown', (e) => {
      zonaGiro.setPointerCapture(e.pointerId)
      arrastrando = true
      cancelAnimationFrame(inercia)
      velocidad = 0
      ultimoX = e.clientX
      historia = [{ x: e.clientX, t: performance.now() }]
      pista?.setAttribute('hidden', '')
    })

    zonaGiro.addEventListener('pointermove', (e) => {
      if (!arrastrando) return
      angulo += (e.clientX - ultimoX) * GRADOS_POR_PIXEL
      ultimoX = e.clientX
      dibujarMalla()

      // Solo los últimos 90 ms: con el gesto entero, un arrastre largo
      // que frena al final igual saldría despedido al soltar.
      const ahora = performance.now()
      historia.push({ x: e.clientX, t: ahora })
      historia = historia.filter((h) => ahora - h.t < 90)
    })

    function soltar(e: PointerEvent): void {
      if (!arrastrando) return
      arrastrando = false
      zonaGiro.releasePointerCapture(e.pointerId)

      const primero = historia[0]
      const ahora = performance.now()
      if (primero && ahora - primero.t > 0) {
        velocidad =
          ((e.clientX - primero.x) / (ahora - primero.t)) * 16 * GRADOS_POR_PIXEL
      }
      if (Math.abs(velocidad) > CORTE) inercia = requestAnimationFrame(girarSolo)
    }

    zonaGiro.addEventListener('pointerup', soltar)
    zonaGiro.addEventListener('pointercancel', soltar)

    /* ── Selección de talle ───────────────────────────────────────────
       El botón de compra arranca deshabilitado y dice qué falta. Un
       botón activo que después tira un error es peor que uno que avisa
       antes. */
    const talles = document.getElementById('talles')
    const botonComprar = document.getElementById('comprar') as HTMLButtonElement
    const avisoTalle = document.getElementById('avisoTalle')!

    talles?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.talle') as HTMLButtonElement | null
      if (!b || b.disabled) return

      talles.querySelectorAll('.talle').forEach((o) =>
        o.setAttribute('aria-pressed', String(o === b))
      )
      avisoTalle.textContent = `TALLE ${b.textContent}`
      botonComprar.disabled = false
      botonComprar.textContent = 'AGREGAR AL CARRITO'
    })
  </script>
</body>
</html>
