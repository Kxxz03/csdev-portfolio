---
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mjölnir Gym — Forja tu fuerza</title>
  <meta name="description" content="En Mjölnir no entrenamos cuerpos débiles. Forjamos guerreros. Fuerza, CrossTraining vikingo, coaching y nutrición." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --black:  #080808;
      --iron:   #111111;
      --steel:  #1a1a1a;
      --ember:  #E85D04;
      --gold:   #FFB703;
      --ash:    rgba(255,255,255,0.55);
      --smoke:  rgba(255,255,255,0.18);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Space Grotesk', system-ui, sans-serif;
      background: var(--black);
      color: #F0EDE8;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      width: 100%;
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* ── NAV ─────────────────────────────────────────── */
    .nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: background 0.4s;
    }

    .nav.scrolled {
      background: rgba(8,8,8,0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
    }

    .nav-logo-img {
      width: 32px; height: 32px;
      object-fit: contain;
      filter: drop-shadow(0 0 6px rgba(232,93,4,0.5));
    }

    .nav-logo-text {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: #F0EDE8;
    }

    .nav-links { display: none; }

    .nav-cta {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--black);
      background: var(--ember);
      padding: 0.6rem 1.4rem;
      transition: background 0.2s;
    }

    .nav-cta:hover { background: var(--gold); }

    @media (max-width: 768px) {
      .nav-links { display: none; }
    }

    @keyframes livePulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(232,93,4,0.7); }
      50% { opacity: 0.8; box-shadow: 0 0 0 5px rgba(232,93,4,0); }
    }

    /* ── HERO ─────────────────────────────────────────── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-rows: 1fr auto;
      position: relative;
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to bottom, rgba(8,8,8,0.6) 0%, rgba(8,8,8,0.25) 45%, rgba(8,8,8,0.85) 80%, var(--black) 100%),
        linear-gradient(to right, rgba(8,8,8,0.7) 0%, transparent 55%),
        radial-gradient(ellipse 80% 60% at 60% 80%, rgba(232,93,4,0.22) 0%, transparent 65%),
        url('/mjolnir/hero-forge.jpg') center/cover no-repeat;
    }

    .hero-bg-watermark {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: -2rem;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }

    .hero-bg-watermark-text {
      font-size: clamp(12rem, 28vw, 32rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.06em;
      text-transform: uppercase;
      color: transparent;
      -webkit-text-stroke: 1px rgba(232,93,4,0.08);
      user-select: none;
      white-space: nowrap;
      margin-right: -4rem;
    }

    .hero-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: linear-gradient(to bottom, transparent 5%, black 25%, black 75%, transparent 100%);
      z-index: 1;
    }

    /* ── CORNER DECORATIONS ───────────────────────────── */
    .hero-corner {
      position: absolute;
      z-index: 3;
      pointer-events: none;
    }

    .hero-corner-tl {
      top: 5rem; left: 2rem;
    }

    .hero-corner-tr {
      top: 5rem; right: 2rem;
      text-align: right;
    }

    .hero-corner-br {
      bottom: 5rem; right: 2rem;
      text-align: right;
    }

    .corner-crosshair {
      width: 20px; height: 20px;
      position: relative;
      display: inline-block;
      margin-bottom: 0.5rem;
    }

    .corner-crosshair::before, .corner-crosshair::after {
      content: '';
      position: absolute;
      background: var(--ember);
      opacity: 0.6;
    }

    .corner-crosshair::before { width: 1px; height: 100%; left: 50%; }
    .corner-crosshair::after  { height: 1px; width: 100%; top: 50%; }

    .corner-label {
      display: block;
      font-size: 0.55rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.2);
      line-height: 1.8;
    }

    /* ── VERTICAL TEXT ────────────────────────────────── */
    .hero-vert-text {
      position: absolute;
      right: 2rem;
      top: 50%;
      transform: translateY(-50%) rotate(90deg);
      transform-origin: center;
      z-index: 3;
      white-space: nowrap;
      font-size: 0.55rem;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.15);
      pointer-events: none;
    }

    /* ── HERO INNER ──────────────────────────────────── */
    .hero-inner {
      position: relative;
      z-index: 4;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-top: 5rem;
      padding-bottom: 3rem;
      flex: 1;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.75rem;
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--ember);
      opacity: 0;
    }

    .hero-eyebrow::before {
      content: '';
      display: block;
      width: 24px; height: 1px;
      background: var(--ember);
    }

    .hero-headline {
      font-size: clamp(3.5rem, 9.5vw, 12rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.04em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .hero-headline em {
      font-style: normal;
      color: var(--ember);
    }

    .hero-headline .accent {
      color: var(--gold);
    }

    /* ── HERO CTA (NEW) ──────────────────────────────── */
    .hero-cta-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 2.75rem;
      opacity: 0;
      flex-wrap: wrap;
    }

    .hero-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--black);
      background: var(--ember);
      padding: 1rem 2rem;
      transition: background 0.2s, transform 0.25s cubic-bezier(0.23,1,0.32,1);
    }

    .hero-btn-primary:hover { background: var(--gold); }

    .hero-btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      text-decoration: none;
      color: rgba(240,237,232,0.65);
      border: 1px solid rgba(255,255,255,0.12);
      padding: 1rem 1.75rem;
      transition: border-color 0.2s, color 0.2s;
    }

    .hero-btn-ghost:hover { border-color: var(--ember); color: var(--ember); }

    /* ── HERO SUB ROW ─────────────────────────────────── */
    .hero-sub-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-top: 3.5rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(255,255,255,0.06);
      opacity: 0;
    }

    .hero-sub {
      font-size: 1rem;
      line-height: 1.7;
      color: var(--ash);
      max-width: 360px;
    }

    .hero-sub strong { color: #F0EDE8; }

    .hero-stats {
      display: flex;
      gap: 3rem;
      flex-shrink: 0;
    }

    .stat-num {
      font-size: 2rem;
      font-weight: 800;
      color: var(--ember);
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .stat-label {
      font-size: 0.6rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--smoke);
      margin-top: 0.3rem;
    }

    /* ── NEXT CLASS BADGE ─────────────────────────────── */
    .hero-next-class {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      right: 2.5rem;
      z-index: 4;
      background: rgba(8,8,8,0.75);
      border: 1px solid rgba(232,93,4,0.3);
      backdrop-filter: blur(12px);
      padding: 1rem 1.25rem;
      min-width: 180px;
      opacity: 0;
    }

    .next-class-label {
      font-size: 0.55rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ember);
      margin-bottom: 0.4rem;
    }

    .next-class-time {
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1;
      color: #F0EDE8;
    }

    .next-class-name {
      font-size: 0.65rem;
      color: var(--smoke);
      margin-top: 0.35rem;
      letter-spacing: 0.08em;
    }

    .next-class-spots {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-top: 0.75rem;
      font-size: 0.6rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--ember);
    }

    .spots-dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      background: var(--ember);
      animation: livePulse 1.5s ease-in-out infinite;
    }

    /* ── HERO MARQUEE STRIP ───────────────────────────── */
    .hero-marquee-strip {
      position: relative;
      z-index: 4;
      overflow: hidden;
      border-top: 1px solid rgba(255,255,255,0.05);
      padding: 0.6rem 0;
      background: rgba(8,8,8,0.6);
      backdrop-filter: blur(4px);
    }

    .hero-marquee-track {
      display: flex;
      width: max-content;
      animation: heroMQ 20s linear infinite;
      gap: 0;
    }

    .hero-marquee-item {
      display: flex;
      align-items: center;
      gap: 2rem;
      padding: 0 2.5rem;
      font-size: 0.6rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: rgba(240,237,232,0.3);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .hero-marquee-sep {
      color: var(--ember);
      opacity: 0.5;
    }

    @keyframes heroMQ {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    .hero-scroll {
      position: absolute;
      bottom: 2.5rem;
      right: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      z-index: 5;
      opacity: 0;
    }

    .hero-scroll-label {
      font-size: 0.55rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.2);
      writing-mode: vertical-rl;
    }

    .hero-scroll-line {
      width: 1px;
      height: 48px;
      background: linear-gradient(to bottom, rgba(255,255,255,0.2), transparent);
      animation: drop 2s ease-in-out infinite;
      transform-origin: top;
    }

    @keyframes drop {
      0%   { transform: scaleY(0); opacity: 0; }
      30%  { opacity: 1; }
      100% { transform: scaleY(1); opacity: 0; }
    }

    /* ── DIVIDER ──────────────────────────────────────── */
    .section-divider {
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(255,255,255,0.08), transparent);
    }

    /* ── ABOUT ────────────────────────────────────────── */
    .about {
      padding: 10rem 0;
      position: relative;
      overflow: hidden;
    }

    .about-bg-text {
      position: absolute;
      bottom: -3rem;
      right: -2rem;
      font-size: clamp(8rem, 20vw, 22rem);
      font-weight: 900;
      letter-spacing: -0.05em;
      color: transparent;
      -webkit-text-stroke: 1px rgba(232,93,4,0.07);
      pointer-events: none;
      user-select: none;
      text-transform: uppercase;
    }

    .about-label {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--ember);
      margin-bottom: 2.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .about-label::before {
      content: '';
      display: block;
      width: 24px; height: 1px;
      background: var(--ember);
    }

    .about-quote {
      font-size: clamp(2rem, 4.5vw, 4.5rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.02em;
      max-width: 900px;
    }

    .about-quote em {
      font-style: normal;
      color: var(--ember);
    }

    .about-body {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      margin-top: 5rem;
      padding-top: 3rem;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    .about-p {
      font-size: 1rem;
      line-height: 1.85;
      color: var(--ash);
    }

    /* ── PROGRAMS ─────────────────────────────────────── */
    .programs {
      padding: 4rem 0 8rem;
    }

    .programs-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      margin-bottom: 4rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .section-label {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--ember);
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .section-label::before {
      content: '';
      display: block;
      width: 20px; height: 1px;
      background: var(--ember);
    }

    .programs-title {
      font-size: clamp(2.5rem, 5vw, 5rem);
      font-weight: 800;
      line-height: 0.95;
      letter-spacing: -0.02em;
    }

    .programs-sub {
      font-size: 0.95rem;
      color: var(--ash);
      max-width: 320px;
      line-height: 1.75;
    }

    /* ── Full-row reveal ─────────────────────────────── */
    .programs-list { display: flex; flex-direction: column; }

    .program-row {
      position: relative;
      overflow: hidden;
      height: 88px;
      border-top: 1px solid rgba(255,255,255,0.07);
      cursor: default;
    }

    .program-row:last-child { border-bottom: 1px solid rgba(255,255,255,0.07); }

    /* Background image — always present, revealed on hover */
    .program-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      opacity: 0;
      transform: scale(1.06);
      transition: opacity 0.55s ease, transform 0.7s ease;
      pointer-events: none;
    }

    .program-bg img {
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center;
    }

    /* Gradient overlay on top of image */
    .program-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        rgba(8,8,8,0.88) 0%,
        rgba(8,8,8,0.55) 60%,
        rgba(8,8,8,0.2) 100%
      );
    }

    /* Content layer */
    .program-content {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 72px 1fr auto;
      align-items: center;
      gap: 2rem;
      padding: 1.5rem 0;
    }

    /* Expanded desc — hidden by default */
    .program-desc {
      font-size: 0.9rem;
      color: rgba(255,255,255,0.65);
      line-height: 1.65;
      max-width: 560px;
      margin-top: 0.6rem;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.3s ease 0.15s, transform 0.3s ease 0.15s;
    }

    .program-num {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      color: var(--ember);
      opacity: 0.4;
      align-self: start;
      padding-top: 0.25rem;
      transition: opacity 0.25s;
    }

    .program-info { align-self: center; }

    .program-cat {
      font-size: 0.6rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.35);
      margin-bottom: 0.3rem;
      transition: color 0.25s;
    }

    .program-title {
      font-size: clamp(1.3rem, 2.4vw, 2.2rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1;
      transition: color 0.25s;
    }

    .program-arrow {
      font-size: 1.4rem;
      color: var(--ember);
      opacity: 0;
      align-self: start;
      padding-top: 0.15rem;
      transform: translate(-6px, 4px);
      transition: opacity 0.25s, transform 0.3s;
      flex-shrink: 0;
    }

    @media (max-width: 768px) {
      .program-arrow { display: none; }
    }

    /* ── CHALLENGE ────────────────────────────────────── */
    .challenge {
      padding: 10rem 0;
      position: relative;
      background: var(--iron);
      overflow: hidden;
    }

    .challenge::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 80% at 50% 50%, rgba(232,93,4,0.12) 0%, transparent 70%);
    }

    .challenge-inner {
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .challenge-hammer {
      display: flex;
      justify-content: center;
      margin-bottom: 2.5rem;
    }

    .challenge-mark {
      width: 72px; height: 72px;
      object-fit: contain;
      filter: drop-shadow(0 0 20px rgba(232,93,4,0.6));
      animation: floatMark 3s ease-in-out infinite;
    }

    @keyframes floatMark {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    .challenge-quote {
      font-size: clamp(2.5rem, 6vw, 7rem);
      font-weight: 900;
      line-height: 0.95;
      letter-spacing: -0.03em;
      text-transform: uppercase;
    }

    .challenge-quote em {
      font-style: normal;
      color: var(--ember);
    }

    .challenge-cta {
      display: inline-block;
      margin-top: 4rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--ember);
      border: 1px solid var(--ember);
      padding: 1rem 2.5rem;
      transition: background 0.2s, color 0.2s;
    }

    .challenge-cta:hover {
      background: var(--ember);
      color: var(--black);
    }

    /* ── TESTIMONIAL ──────────────────────────────────── */
    .testimonial {
      padding: 10rem 0;
    }

    .testimonial-inner {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 6rem;
      align-items: center;
    }

    .testimonial-label {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--ember);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .testimonial-label::before {
      content: '';
      display: block;
      width: 20px; height: 1px;
      background: var(--ember);
    }

    .testimonial-name {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      line-height: 1;
    }

    .testimonial-since {
      font-size: 0.7rem;
      color: var(--smoke);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-top: 0.5rem;
    }

    .testimonial-quote {
      font-size: clamp(1.5rem, 3vw, 2.8rem);
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: -0.01em;
    }

    .testimonial-quote::before {
      content: '"';
      color: var(--ember);
      margin-right: 0.1em;
    }

    .testimonial-quote::after {
      content: '"';
      color: var(--ember);
      margin-left: 0.1em;
    }

    /* ── VISIT ────────────────────────────────────────── */
    .visit {
      padding: 4rem 0 10rem;
    }

    .visit-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: rgba(255,255,255,0.06);
    }

    .visit-cell {
      background: var(--iron);
      padding: 4rem;
    }

    .visit-icon {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
      display: block;
      color: var(--ember);
    }

    .visit-cell-label {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.3em;
      text-transform: uppercase;
