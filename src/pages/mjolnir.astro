          <div class="program-row">
            <div class="program-bg">
              <img src="/mjolnir/nutrition.jpg" alt="" />
            </div>
            <div class="program-content" data-reveal data-reveal-delay="3">
              <span class="program-num">04</span>
              <div class="program-info">
                <div class="program-cat">Alimentación</div>
                <div class="program-title">Nutrición de Guerrero</div>
                <div class="program-desc">Planes alimenticios que alimentan el músculo, no la excusa. Ciencia aplicada.</div>
              </div>
              <span class="program-arrow">↗</span>
