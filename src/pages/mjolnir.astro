        <div class="visit-grid" id="unete">
          <div class="visit-cell" data-reveal>
            <span class="visit-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <div class="visit-cell-label">Horarios</div>
            <h3 class="visit-cell-title">Las puertas<br />de la forja</h3>
            <p>Abrimos las puertas de la forja:</p>
            <div class="visit-hours">Lun – Sáb · 6:00 — 22:00</div>
            <div class="visit-note">Domingo: descansa, guerrero.</div>
          </div>
          <div class="visit-cell" data-reveal data-reveal-delay="1">
            <span class="visit-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </span>
            <div class="visit-cell-label">Únete</div>
            <h3 class="visit-cell-title">Cruza<br />el umbral</h3>
            <p>Escribe a la tribu. Te decimos cuándo presentarte ante el yunque.</p>
            <div class="visit-btns">
              <a href="https://wa.me/595982531706" target="_blank" rel="noopener" class="btn-primary">
                WhatsApp
              </a>
              <a href="https://instagram.com/its_csdev" target="_blank" rel="noopener" class="btn-ghost">
                Instagram
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-logo">
          <img src="/mjolnir/mjolnir-mark.png" alt="Mjölnir" class="footer-mark-img" />
          <div>
            <div class="footer-name">Mjölnir Gym</div>
            <div class="footer-tagline">No se pide permiso para ser fuerte</div>
          </div>
        </div>
        <div class="footer-social">
          <a href="#">Instagram</a>
          <a href="#">WhatsApp</a>
        </div>
      </div>
      <div class="footer-copy">
        © 2026 Mjölnir Gym · Forjado en el norte
      </div>
    </div>
  </footer>

</body>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Nav scroll state
  const nav = document.getElementById('nav')!;
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 60);
  }, { passive: true });

  // Programs full-row reveal (GSAP-driven)
  const rows = document.querySelectorAll<HTMLElement>('.program-row');
  const COLLAPSED = 88;
  const EXPANDED = 280;

  rows.forEach(row => {
    const content = row.querySelector<HTMLElement>('.program-content')!;
    const bg = row.querySelector<HTMLElement>('.program-bg')!;
    const desc = row.querySelector<HTMLElement>('.program-desc')!;
    const num = row.querySelector<HTMLElement>('.program-num')!;
    const arrow = row.querySelector<HTMLElement>('.program-arrow')!;
    const cat = row.querySelector<HTMLElement>('.program-cat')!;

    // overflow already set in CSS; GSAP animates height

    row.addEventListener('mouseenter', () => {
      gsap.to(row, { height: EXPANDED, duration: 0.55, ease: 'power3.out' });
      gsap.to(bg, { opacity: 1, scale: 1, duration: 0.55, ease: 'power3.out' });
      gsap.to(desc, { opacity: 1, y: 0, duration: 0.35, ease: 'power2.out', delay: 0.15 });
      gsap.to(arrow, { opacity: 1, x: 2, y: -2, duration: 0.25, ease: 'power2.out' });
      gsap.to(cat, { color: '#E85D04', duration: 0.2 });
      gsap.to(num, { opacity: 1, duration: 0.2 });
    });

    row.addEventListener('mouseleave', () => {
      gsap.to(row, { height: COLLAPSED, duration: 0.4, ease: 'power3.inOut' });
      gsap.to(bg, { opacity: 0, scale: 1.06, duration: 0.4, ease: 'power3.inOut' });
      gsap.to(desc, { opacity: 0, y: 6, duration: 0.2, ease: 'power2.in' });
      gsap.to(arrow, { opacity: 0, x: -6, y: 4, duration: 0.2 });
      gsap.to(cat, { color: 'rgba(255,255,255,0.35)', duration: 0.2 });
      gsap.to(num, { opacity: 0.4, duration: 0.2 });
    });
  });

  // Set initial positions via JS (not CSS) to avoid layout shift on load
  gsap.set('#heroEyebrow', { y: 14 });
  gsap.set('.hero-word',   { y: 40, skewY: 4 });
  gsap.set('#heroCta',     { y: 20 });
  gsap.set('#heroSub',     { y: 16 });
  gsap.set('#heroNextClass', { x: 16 });

  // Hero entrance
  const tl = gsap.timeline({ delay: 0.3 });
  tl.to('#heroEyebrow',   { opacity: 1, y: 0,  duration: 0.6, ease: 'power3.out', clearProps: 'transform' })
    .to('.hero-word', {
      opacity: 1, y: 0, skewY: 0,
      duration: 0.9, ease: 'power3.out',
      stagger: 0.09,
      clearProps: 'transform'
    }, '-=0.3')
    .to('#heroCta',       { opacity: 1, y: 0,  duration: 0.6,  ease: 'power3.out', clearProps: 'transform' }, '-=0.45')
    .to('#heroSub',       { opacity: 1, y: 0,  duration: 0.65, ease: 'power3.out', clearProps: 'transform' }, '-=0.45')
    .to('#heroNextClass', { opacity: 1, x: 0,  duration: 0.55, ease: 'power3.out', clearProps: 'transform' }, '-=0.5')
    .to('#heroScrollInd', { opacity: 1,         duration: 0.4,  ease: 'power2.out' }, '-=0.3');

  // ── Parallax hero background ──────────────────────────
  const heroBg = document.querySelector<HTMLElement>('.hero-bg');
  if (heroBg) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY * 0.35;
      heroBg.style.transform = `translateY(${y}px)`;
    }, { passive: true });
  }

  // ── Counter animation on stats ────────────────────────
  function animCount(el: HTMLElement, target: number, suffix: string, duration = 1400) {
    let start: number | null = null;
    const step = (ts: number) => {
      if (!start) start = ts;
      const progress = Math.min((ts - start) / duration, 1);
      const ease = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(ease * target) + suffix;
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  const counterData: { selector: string; target: number; suffix: string }[] = [
    { selector: '.hero-stats .stat-num:nth-child(1)', target: 500, suffix: '+' },
    { selector: '.hero-stats .stat-num:nth-child(2)', target: 16, suffix: 'h' },
  ];

  const statsSection = document.querySelector('.hero-stats');
  if (statsSection) {
    const statNums = statsSection.querySelectorAll<HTMLElement>('.stat-num');
    const pairs = [
      { el: statNums[0], target: 500, suffix: '+' },
      { el: statNums[1], target: 16,  suffix: 'h' },
    ];
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        pairs.forEach(({ el, target, suffix }) => el && animCount(el, target, suffix));
      }
    }, { threshold: 0.5 }).observe(statsSection);
  }

  // ── Magnetic buttons ──────────────────────────────────
  document.querySelectorAll<HTMLElement>('.nav-cta, .challenge-cta').forEach(btn => {
    btn.addEventListener('mousemove', (e: MouseEvent) => {
      const r = btn.getBoundingClientRect();
      const x = (e.clientX - r.left - r.width / 2) * 0.35;
      const y = (e.clientY - r.top - r.height / 2) * 0.35;
      btn.style.transform = `translate(${x}px, ${y}px)`;
    });
    btn.addEventListener('mouseleave', () => { btn.style.transform = ''; });
  });

  // ── Agenda dinámica ──────────────────────────────────
  const CLASSES = [
    { time: '06:00', name: 'Entrenamiento de Fuerza',  coach: 'Coach Marcos',    cap: 12 },
    { time: '08:00', name: 'CrossTraining Vikingo',     coach: 'Coach Valentina', cap: 16 },
    { time: '10:00', name: 'Coaching 1 a 1',            coach: 'Coach Marcos',    cap: 4  },
    { time: '12:00', name: 'Entrenamiento de Fuerza',  coach: 'Coach Rodrigo',   cap: 12 },
    { time: '17:00', name: 'CrossTraining Vikingo',     coach: 'Coach Valentina', cap: 16 },
    { time: '19:00', name: 'Nutrición de Guerrero',     coach: 'Coach Luisa',     cap: 20 },
    { time: '21:00', name: 'Entrenamiento de Fuerza',  coach: 'Coach Rodrigo',   cap: 12 },
  ];

  // Seed taken spots per slot (deterministic per day+slot index)
  function takenSpots(dayIdx: number, slotIdx: number, cap: number): number {
    const seed = (dayIdx * 7 + slotIdx * 3 + 11) % 13;
    return Math.min(cap, Math.floor((seed / 13) * cap * 1.1));
  }

  const today = new Date();
  const dayOfWeek = today.getDay(); // 0=Sun
  const mondayOffset = dayOfWeek === 0 ? -6 : 1 - dayOfWeek;
  const weekDays = Array.from({ length: 6 }, (_, i) => {
    const d = new Date(today);
    d.setDate(today.getDate() + mondayOffset + i);
    return d;
  });

  const DAY_NAMES = ['LUN', 'MAR', 'MIÉ', 'JUE', 'VIE', 'SÁB'];
  let activeDay = 0;
  // Default to today's weekday if in range
  const todayWeekIdx = today.getDay() === 0 ? -1 : today.getDay() - 1;
  if (todayWeekIdx >= 0 && todayWeekIdx < 6) activeDay = todayWeekIdx;

  const bookedSlots = new Set<string>();

  function renderDays() {
    const container = document.getElementById('agendaDays')!;
    container.innerHTML = weekDays.map((d, i) => {
      const isToday = d.toDateString() === today.toDateString();
      return `
        <div class="agenda-day${i === activeDay ? ' active' : ''}${isToday ? ' today' : ''}" data-day="${i}">
          <div class="day-name">${DAY_NAMES[i]}</div>
          <div class="day-num">${d.getDate()}</div>
          ${isToday ? '<div class="day-today-badge">HOY</div>' : ''}
        </div>`;
    }).join('');
    container.querySelectorAll('.agenda-day').forEach(el => {
      el.addEventListener('click', () => {
        activeDay = Number((el as HTMLElement).dataset.day);
        renderDays();
        renderGrid();
      });
    });
  }

  function renderGrid() {
    const container = document.getElementById('agendaGrid')!;
    const dayDate = weekDays[activeDay];
    const isPast = dayDate < new Date(today.getFullYear(), today.getMonth(), today.getDate());

    container.innerHTML = CLASSES.map((cls, i) => {
      const key = `${activeDay}-${i}`;
      const taken = bookedSlots.has(key) ? cls.cap : takenSpots(activeDay, i, cls.cap);
      const avail = cls.cap - taken;
      const isFull = avail <= 0;
      const isBooked = bookedSlots.has(key);
      const pips = Array.from({ length: Math.min(cls.cap, 8) }, (_, p) =>
        `<span class="spot-pip${p < Math.round(taken * Math.min(cls.cap,8) / cls.cap) ? ' taken' : ''}"></span>`
      ).join('');

      let action = '';
      if (isPast) {
        action = `<span class="slot-full-tag">Sesión pasada</span>`;
      } else if (isBooked) {
        action = `<span class="slot-booked-tag">✓ Reservado</span>`;
      } else if (isFull) {
        action = `<span class="slot-full-tag">Completo</span>`;
      } else {
        action = `<button class="slot-btn" data-key="${key}" data-time="${cls.time}" data-name="${cls.name}">Reservar lugar</button>`;
      }

      return `
        <div class="agenda-slot${isFull && !isBooked ? ' full' : ''}${isBooked ? ' booked' : ''} ${!isFull && !isPast ? 'available' : ''}">
          <div class="slot-time">${cls.time}</div>
          <div class="slot-name">${cls.name}</div>
          <div class="slot-meta">
            <span>${cls.coach}</span>
            <span>·</span>
            <span>${avail > 0 ? avail + ' lugares' : 'lleno'}</span>
          </div>
          <div class="spots-bar" style="margin-bottom:0">${pips}</div>
          ${action}
        </div>`;
    }).join('');

    // Book handlers
    container.querySelectorAll('.slot-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const key = el.dataset.key!;
        bookedSlots.add(key);
        const detail = `${el.dataset.name} · ${DAY_NAMES[activeDay]} ${weekDays[activeDay].getDate()} a las ${el.dataset.time}`;
        showConfirm(detail);
        renderGrid();
      });
    });
  }

  function showConfirm(detail: string) {
    const panel = document.getElementById('agendaConfirm')!;
    const detailEl = document.getElementById('confirmDetail')!;
    detailEl.textContent = detail;
    panel.style.display = 'block';
    gsap.fromTo(panel, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.3, ease: 'power2.out' });
    document.getElementById('confirmClose')?.addEventListener('click', () => {
      gsap.to(panel, { y: 10, opacity: 0, duration: 0.2, onComplete: () => { panel.style.display = 'none'; } });
    }, { once: true });
  }

  renderDays();
  renderGrid();

  // ── Scroll reveals ────────────────────────────────────
  document.querySelectorAll('[data-reveal]').forEach((el) => {
    const delay = parseFloat((el as HTMLElement).dataset.revealDelay || '0') * 0.15;
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 0.8,
      delay,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: el,
        start: 'top 88%',
        once: true,
      },
    });
  });
</script>
</html>
