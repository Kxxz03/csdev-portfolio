    <!-- AGENDA -->
    <section class="agenda" id="agenda">
      <div class="container">
        <div class="agenda-header" data-reveal>
          <div>
            <div class="section-label">Reservas</div>
            <h2 class="agenda-title">Si sos miembro,<br /><em>agendá tu sesión.</em></h2>
          </div>
          <p class="agenda-sub">Turnos disponibles esta semana. Seleccioná el horario y confirmá tu lugar en la tribu.</p>
        </div>
        <div class="agenda-ui" data-reveal data-reveal-delay="1">
          <!-- Day tabs -->
          <div class="agenda-days" id="agendaDays"></div>
          <!-- Schedule grid -->
          <div class="agenda-grid" id="agendaGrid"></div>
          <!-- Confirm panel -->
          <div class="agenda-confirm" id="agendaConfirm" style="display:none">
            <div class="confirm-inner">
              <div class="confirm-icon">✓</div>
              <div class="confirm-text">
                <strong id="confirmTitle">Lugar reservado</strong>
                <span id="confirmDetail"></span>
              </div>
              <button class="confirm-close" id="confirmClose">✕</button>
