    </section>

    <!-- CHALLENGE -->
    <section class="challenge" id="reto">
      <div class="container">
        <div class="challenge-inner">
          <div class="challenge-hammer" aria-hidden="true">
            <img src="/mjolnir/mjolnir-mark.png" alt="" class="challenge-mark" />
          </div>
          <h2 class="challenge-quote" data-reveal>
            No todos pueden<br />
            levantar el martillo.<br />
            <em>¿Eres digno?</em>
          </h2>
          <a href="#unete" class="challenge-cta" data-reveal data-reveal-delay="1">
            Acepto el reto
