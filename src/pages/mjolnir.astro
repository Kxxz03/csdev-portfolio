      background: rgba(232,93,4,0.07);
    }

    .agenda-day.active::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 2px;
      background: var(--ember);
    }

    .day-name {
      font-size: 0.55rem;
      font-weight: 700;
